rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    // ---------- Funções auxiliares ----------
    function logado() { return request.auth != null; }
    function perfil() {
      return get(/databases/$(db)/documents/usuarios/$(request.auth.uid)).data;
    }
    function ehSuper() { return logado() && perfil().papel == 'superadmin'; }
    function ehDono(id) { return logado() && perfil().negocioId == id; }
    function podeGerenciar(id) { return ehSuper() || ehDono(id); }

    // ---------- Usuários (quem acessa painel/admin) ----------
    match /usuarios/{uid} {
      allow read: if logado() && (request.auth.uid == uid || ehSuper());
      allow write: if ehSuper();
    }

    // ---------- Negócios ----------
    match /negocios/{id} {
      function negocioAtivo() {
        return get(/databases/$(db)/documents/negocios/$(id)).data.ativo == true;
      }

      // Qualquer um abre a página de UM negócio, mas só você lista todos
      allow get: if true;
      allow list: if ehSuper();
      allow create, delete: if ehSuper();
      // O dono edita o próprio negócio, mas não pode se reativar nem trocar de plano
      // Serviços e profissionais ficam em arrays aqui dentro (economiza leituras)
      allow update: if ehSuper() || (ehDono(id)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['ativo', 'plano'])
        && request.resource.data.get('servicos', []).size() <= 100
        && request.resource.data.get('profissionais', []).size() <= 30);

      // Folgas e horários bloqueados (só o dono vê e mexe)
      match /bloqueios/{bid} {
        allow read, write: if podeGerenciar(id);
      }

      // O ID de um horário é "profissional_data_hhmm" (ex.: "ana_2026-11-20_1430").
      // Os campos gravados precisam bater com o ID: assim ninguém trava um horário
      // usando o ID de outro.
      function idDoHorario(d) {
        return d.profissionalId + '_' + d.data + '_' + d.hora.replace(':', '');
      }
      function dataEHoraValidas(d) {
        return d.profissionalId is string && d.profissionalId.matches('[a-z0-9]{1,40}')
          && d.data is string && d.data.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
          && d.hora is string && d.hora.matches('[0-9]{2}:[0-9]{2}');
      }

      // Dados do cliente: PRIVADO. O ID do documento é o 1º horário (slot).
      match /agendamentos/{slot} {
        allow read, update, delete: if podeGerenciar(id);
        allow create: if negocioAtivo()
          && request.resource.data.status == 'confirmado'
          && request.resource.data.clienteNome is string
          && request.resource.data.clienteNome.size() > 0
          && request.resource.data.clienteNome.size() <= 80
          && request.resource.data.clienteTelefone is string
          && request.resource.data.clienteTelefone.size() >= 10
          && request.resource.data.clienteTelefone.size() <= 20
          && dataEHoraValidas(request.resource.data)
          && slot == idDoHorario(request.resource.data)
          && request.resource.data.slots is list
          && request.resource.data.slots.size() > 0
          && request.resource.data.slots.size() <= 16
          && request.resource.data.slots[0] == slot
          && existsAfter(/databases/$(db)/documents/negocios/$(id)/ocupados/$(slot));
      }

      // Histórico de agendamentos cancelados (só o dono vê)
      match /cancelados/{cid} {
        allow read, write: if podeGerenciar(id);
      }

      // Só marca "horário pego", sem dados pessoais. Público para leitura.
      // Não existe regra de update: um horário ocupado nunca é sobrescrito.
      match /ocupados/{slot} {
        function ocupadoDeAgendamento() {
          let d = request.resource.data;
          let ag = getAfter(/databases/$(db)/documents/negocios/$(id)/agendamentos/$(d.agendamentoId)).data;
          return d.agendamentoId is string
            && dataEHoraValidas(d)
            && slot == idDoHorario(d)
            && slot in ag.slots
            && d.data == ag.data
            && d.profissionalId == ag.profissionalId;
        }
        allow read: if true;
        allow delete: if podeGerenciar(id);
        // O dono também pode criar direto (para bloquear horários e folgas)
        allow create: if podeGerenciar(id) || (negocioAtivo() && ocupadoDeAgendamento());
      }
    }
  }
}
